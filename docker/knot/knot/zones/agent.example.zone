$ORIGIN agent.example.
$TTL 3600

@   IN SOA ns1.agent.example. hostmaster.agent.example. (
        2026050501 ; serial
        3600       ; refresh
        900        ; retry
        1209600    ; expire
        300        ; minimum
)

@       IN NS ns1.agent.example.
ns1     IN A 127.0.0.1
@       IN A 192.0.2.10
_er     IN NS ns1.agent.example.
